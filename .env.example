# Template for .env — copy to .env and fill in. Never commit the real .env.

# PostgreSQL connection (Supabase dev DB or VDHY045 production — see CLAUDE.md)
DATABASE_URL=postgresql://<user>:<password>@<host>:5432/postgres
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=
SUPABASE_DB_PASSWORD=

# Fieldglass — supplied externally by the team
FIELDGLASS_URL=
FIELDGLASS_USERNAME=
FIELDGLASS_PASSWORD=

# Optional: cap detail pages visited during smoke runs (unset = all)
# FIELDGLASS_MAX_JOBS=5
# Optional: run headless for unattended runs
# FIELDGLASS_HEADLESS=1

# Chat LLM (workers/chat.py + chatbot/) — OpenAI-compatible endpoint.
# Current dev setup: Qwen2.5-7B on Modal via vLLM (deploy: py -m modal deploy
# modal_app/qwen_vllm.py; LLM_API_KEY = the vllm-api-key Modal secret).
# Unset LLM_BASE_URL/LLM_MODEL to fall back to Groq defaults (key from
# https://console.groq.com/keys); for the VDHY045 local model, point
# LLM_BASE_URL at the on-server endpoint instead.
LLM_API_KEY=
# LLM_BASE_URL=https://<workspace>--qwen-vllm-serve.modal.run/v1
# LLM_MODEL=qwen2.5-7b-instruct

# Chatbot API (chatbot/api/server.py) — all optional; defaults suit laptop dev.
# CHATBOT_API_TOKEN=          # set to require "Authorization: Bearer <token>" (unset = auth off)
# CHATBOT_ALLOWED_ORIGINS=http://localhost:8000   # comma-separated CORS origins
# CHATBOT_RATE_LIMIT=20       # chat requests/min per client IP (0 = off)
# CHATBOT_DB_POOL_SIZE=5      # Postgres connection pool size
# CHATBOT_WORKERS=1           # >1 requires EMBED_SERVICE_URL (else each worker loads the model)
# CHATBOT_HOST=127.0.0.1      # 0.0.0.0 to accept LAN/Docker traffic
# Embedding service — honored by ALL embedding callers (chat CLI, hybrid
# search, embed worker, chatbot API), not just the API. Unset = in-process.
# Local:  EMBED_SERVICE_URL=http://localhost:8100  (py chatbot/api/embed_service.py)
# Modal:  EMBED_SERVICE_URL=https://<workspace>--bge-embed-embedder-api.modal.run
#         EMBED_SERVICE_TOKEN=<embed-api-key Modal secret>   (dev only — governance)
# EMBED_SERVICE_URL=
# EMBED_SERVICE_TOKEN=
